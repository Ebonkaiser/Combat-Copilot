# Copy to .env and fill in. NEVER commit .env: it holds secrets.
# On the Droplet the real .env sits next to docker-compose.yml; every key below is read from there.
# Lines starting with "#" are comments; leave a key empty (or delete it) to keep its default.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Gemini API key (narration + embeddings). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Defaults to "production" when unset or unrecognised. Values: production | development | test.
# "development" is for your own machine ONLY: it sends session cookies without the Secure flag
# (plain http://localhost), relaxes the sign-in rate limits and enables the dev sign-in helper.
# Never set it on a public host.
ENV=production

# ---------------------------------------------------------------------------
# Owner mode (optional). Leave OWNER_EMAILS empty to run anonymous-only.
# Anonymous visitors get the public SRD rules; the owner also unlocks private campaigns.
# ---------------------------------------------------------------------------
# Comma-separated allowlist of owner email addresses (case-insensitive).
OWNER_EMAILS=

# Signs the session cookie and keys the stored sign-in codes: at least 32 random bytes, kept secret.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs every session out.
SESSION_SECRET=

# Origins that may call the API from another site. Leave EMPTY in production: nginx serves the
# app and /api from one origin, so no cross-site access is needed (or granted). With ENV=development
# it defaults to http://localhost:4200. A wildcard (*) is never honoured.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Email delivery of sign-in codes (required for owner sign-in in production)
# DigitalOcean blocks SMTP, so delivery uses a provider's HTTPS API.
# ---------------------------------------------------------------------------
# resend  = Resend (https://resend.com). console = log the code (ENV=development or test only).
EMAIL_PROVIDER=resend
# A send-only Resend API key. Put it ONLY in the Droplet's .env -- never in chat, tickets or git.
EMAIL_API_KEY=
# A sender on a domain you have verified with Resend (DNS records), e.g.
# EMAIL_FROM="Combat Copilot <login@mail.example.com>"
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Campaigns (private lore + starter roster)
# ---------------------------------------------------------------------------
# One folder per campaign: <CAMPAIGNS_DIR>/<slug>/{campaign.yaml, roster.yaml, lore/**/*.md}.
# Never committed and never baked into the image. In Docker it is bind-mounted read-only at
# /app/data/campaigns from ./campaigns next to docker-compose.yml, so the default is right there.
CAMPAIGNS_DIR=./data/campaigns

# ---------------------------------------------------------------------------
# Development / test only (ignored in production)
# ---------------------------------------------------------------------------
# FAKE_AI=1       offline echo narrator + hashing embeddings, no Gemini key needed.
#                 Honoured only when ENV is development or test.
# STATE_DB_PATH=  where encounters are stored (default ./state_db/combat_state.db)
# CHROMA_DIR=     where the vector store lives (default ./chroma_db)

# ---------------------------------------------------------------------------
# Written for you by scripts/provision-droplet.sh (Docker Compose image selection)
# ---------------------------------------------------------------------------
# IMAGE_NAME=ghcr.io/<owner>/<repo>
# IMAGE_TAG=latest
