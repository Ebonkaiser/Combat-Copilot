# Secrets -- never commit
.env
.env.*
# ...but the documented template (placeholders only, no values) is meant to be committed.
!.env.example
*.pem
*_deploy_key
*_deploy_key.pub

# Python
__pycache__/
*.pyc
.pytest_cache/

# Private campaign content (lore + roster) -- never commit: this repo and the
# image built from it are public. On the droplet it lives in ~/combat-copilot/campaigns/.
# (The synthetic test fixture under tests/fixtures/campaigns/ is NOT ignored.)
data/campaigns/
/campaigns/

# Generated/runtime data -- belongs in a volume, not the repo
chroma_db/
test_chroma_db/
state_db/

# Frontend (has its own .gitignore too, but belt-and-suspenders at the root)
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Unrelated nested project
GMAssistant/
